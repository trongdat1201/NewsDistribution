    <appSettings>
        <add key="GeminiApiKey" value="" />
        <add key="GeminiModel" value="gemini-3.5-flash" />
        <add key="GeminiApiUrl" value="https://generativelanguage.googleapis.com/v1beta/models" />

        <add key="OllamaBaseUrl" value="http://localhost:11434" />
        <add key="OllamaModel" value="qwen3.6" />

        <add key="EmbeddingModel" value="nomic-embed-text" />
        <add key="UseOllamaEmbeddings" value="true" />

        <add key="ClaudeBaseUrl" value="https://modelapi.vn" />
        <add key="ClaudeModel" value="claude-sonnet-4-6" />

        <add key="AIProviderMode" value="2" />
        <add key="OllamaTimeoutSeconds" value="60" />
    </appSettings>
